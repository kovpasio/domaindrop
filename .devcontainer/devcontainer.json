{
  "name": "DROP.ZONE",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": {
      "label": "DROP.ZONE",
      "onAutoForward": "openPreview",
      "visibility": "public"
    },
    "8000": {
      "label": "DROP.ZONE API",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "postCreateCommand": "cp -n .env.example .env || true; sed -i 's/^BIND_HOST=.*/BIND_HOST=0.0.0.0/' .env; docker compose up -d --build",
  "postStartCommand": "docker compose up -d",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "remoteUser": "vscode"
}
